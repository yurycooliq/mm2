{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mm2 frozen trial",
  "type": "object",
  "required": ["schema_version", "kind", "family", "author", "candidate_sha", "baseline_sha", "config_hash", "evaluator_hash", "policy_hash", "emulator_hash", "criteria", "datasets", "required_receipts", "embargo_seconds", "carryover_policy", "max_family_trials"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["strategy", "measurement", "reliability"]},
    "family": {"type": "string", "maxLength": 160},
    "author": {"type": "string", "maxLength": 160},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "emulator_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criteria": {"type": "array", "minItems": 1, "maxItems": 32},
    "datasets": {"type": "object", "required": ["development", "holdout", "forward"]},
    "required_receipts": {"type": "object", "required": ["ci", "review", "replay", "forward", "performance", "recovery"]},
    "embargo_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
    "carryover_policy": {"const": "preserve-full-inventory-and-cash"},
    "max_family_trials": {"type": "integer", "minimum": 1, "maximum": 100}
  },
  "$comment": "Python validator additionally checks chronology, frozen family budget, consumption, independent principals and exact hashes. Forward dataset is a future window contract with no preexisting observed bundles."
}
