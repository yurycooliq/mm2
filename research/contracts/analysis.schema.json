{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mm2 actionable issue specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_hash", "title", "scope", "failure_family", "version_epoch", "mechanism_id", "evidence", "sections"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 220},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["account_id", "lane", "component"],
      "properties": {
        "account_id": {"type": "string", "maxLength": 256},
        "lane": {"type": "string", "maxLength": 256},
        "component": {"type": "string", "maxLength": 256}
      }
    },
    "failure_family": {"type": "string", "minLength": 1, "maxLength": 256},
    "version_epoch": {"type": "string", "minLength": 1, "maxLength": 256},
    "mechanism_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["bundle_id", "artifact", "sha256"],
        "properties": {
          "bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "artifact": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "labels": {"type": "array", "maxItems": 6, "items": {"enum": ["research", "data-quality", "accounting", "execution", "performance", "reliability", "needs-evidence", "experiment-running", "needs-live-approval", "rejected", "superseded"]}},
    "sections": {
      "type": "object", "additionalProperties": false,
      "required": ["problem", "confirmed", "hypothesis", "unknowns", "alternative", "mechanism", "metric", "implementation", "recovery_risk", "tests", "acceptance", "rollout", "rollback"],
      "properties": {
        "problem": {"type": "string", "minLength": 1},
        "confirmed": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "unknowns": {"type": "string", "minLength": 1},
        "alternative": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1},
        "recovery_risk": {"type": "string", "minLength": 1},
        "tests": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1},
        "rollout": {"type": "string", "minLength": 1},
        "rollback": {"type": "string", "minLength": 1}
      }
    },
    "experiment_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "dependencies": {"type": "array", "maxItems": 32, "items": {"type": "integer", "minimum": 1, "maximum": 1000000}}
  }
}
